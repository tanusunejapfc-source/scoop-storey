# Railway PostgreSQL Connection String (provided automatically by Railway Postgres service)
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway

# Server Port (provided automatically by Railway)
PORT=3000

# Optional custom directory for uploaded product images, videos, and payment screenshots.
# When a Railway Volume is attached, RAILWAY_VOLUME_MOUNT_PATH is detected automatically.
# UPLOAD_DIR=/data/uploads
